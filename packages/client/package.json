{
  "name": "@conduit/client",
  "version": "0.0.0",
  "description": "ConduitClient — failover router and subscription manager",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@conduit/core": "workspace:^",
    "@conduit/ledger": "workspace:^",
    "@conduit/providers": "workspace:^",
    "@conduit/symbology": "workspace:^",
    "p-retry": "^8.0.0",
    "zod": "^4.5.4"
  }
}
